@using Travel_Blogging.Models;

@{
    var datas = ViewData["posts"] as List<PostModel>;
}



<link rel="stylesheet" href="~/css/pages/AllPost.css" />

<div class="all-post">
    <p class="all-post-heading">ALL POSTS</p>
    <div class="all-post-content">
        @foreach(var post in datas?? new List<PostModel>())
        {
            <div class="all-post-content-box" onclick="window.location.href='@Url.Action("PostDetails", "Post", new{id=post.Id})'">
                <img src=@post.ImageUrl />
                <p>@post.Title</p>
                <p>📍@post.CreatedAt.ToString("dd-MM-yyyy")</p>
            </div>
        }
    </div>
</div>