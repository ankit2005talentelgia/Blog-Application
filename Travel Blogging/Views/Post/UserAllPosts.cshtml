@{
}

@using Travel_Blogging.Models;

@{
    var datas = ViewData["posts"] as List<PostModel>;
}



<link rel="stylesheet" href="~/css/pages/AllPost.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="all-post">
    <!-- Header Section -->
    <div class="all-post-header">
        @if (ViewBag.isDraft == true)
        {
            <p class="all-post-heading">Your Drafts</p>
        }
        else
        {
            <p class="all-post-heading">Your Journeys</p>
        }
    </div>

    @if (datas != null && datas.Count > 0)
    {
        <div class="all-post-content">
            @foreach (var post in datas)
            {
                bool isDraft = ViewBag.isDraft ?? false;
                <div class="all-post-content-box"
                    @(isDraft ? "style='cursor:default'" : "onclick=\"window.location.href='" + Url.Action("PostDetails", "Post", new { id = post.Id }) + "'\"")>
                    
                    <!-- Hover Actions Overlay -->
                    <div class="post-actions-overlay">
                        <button class="action-btn edit-btn" post-id="@post.Id" title="Edit Post">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </button>
                        <button class="action-btn delete-btn" post-id="@post.Id" title="Delete Post">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>

                    <div class="image-wrapper">
                        <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" />
                    </div>
                    
                    <div class="post-info">
                        <p class="post-title">@post.Title</p>
                        <div class="post-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>@post.Location</span>
                        </div>
                        <div class="post-footer">
                            <span class="post-date">
                                <i class="fa-regular fa-calendar-days"></i>
                                @post.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                            @if (!isDraft)
                            {
                                <i class="fa-solid fa-arrow-right"></i>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="post-empty-box">
            <img src="/photos/empty-box.png" alt="Empty" />
            <p>You haven't added any journeys yet.</p>
            <button onclick="window.location.href='@Url.Action("UploadPost", "Post")'">Create Journey</button>
        </div>
    }
</div>

<script>
    // Handle Delete Post
    document.querySelectorAll(".delete-btn").forEach(button => {
        button.addEventListener("click", function (e) {
            e.stopPropagation();

            const postId = parseInt(this.getAttribute("post-id"));
            if (confirm("Are you sure you want to delete this post?")) {
                fetch("/post/delete", {
                    method: "DELETE",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ PostId: postId })
                })
                .then(res => {
                    if (res.ok) location.reload();
                    else alert("Failed to delete post.");
                })
                .catch(err => console.error("Error:", err));
            }
        });
    });

    // Handle Edit Post
    document.querySelectorAll(".edit-btn").forEach(button => {
        button.addEventListener("click", function (e) {
            e.stopPropagation();
            const postId = this.getAttribute("post-id");
            window.location.href = `/post/edit/${postId}`;
        });
    });
</script>