<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<!-- SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@using Travel_Blogging.Models;

@{
    var datas = ViewData["posts"] as List<PostModel>;
}



<link rel="stylesheet" href="~/css/pages/AllPost.css" />

<div class="all-post">
    @if (datas?.Count>0)
    {
        @* Updated by Antigravity: Showing title based on boolean flag passed from controller *@
        @if (ViewBag.isDraft == true)
        {
            <p class="all-post-heading">DRAFT POSTS</p>
        }
        else
        {
            <p class="all-post-heading">YOUR ALL POSTS</p>
        }

        <div class="all-post-content">
            @foreach (var post in datas ?? new List<PostModel>())
            {
                @* Disabled redirection to PostDetails if viewing Drafts *@
                bool isDraft = ViewBag.isDraft ?? false;
                <div class="all-post-content-box @(isDraft ? "draft-no-click" : "")"
                    @(isDraft ? "" : "onclick=" + $"window.location.href='{Url.Action("PostDetails", "Post", new { id = post.Id })}'")>

                    <img src=@post.ImageUrl />
                    <p class="all-post-content-box-title">
                        <svg style="margin-bottom: 6px;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                            <path style="color: #de0d0d" d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                        </svg>
                        @post.Title</p>

                    <div class="all-post-delete-section">
                        <p>
                            @post.CreatedAt.ToString("dd-MM-yyyy")
                        </p>

                        <div>
                            <svg xmlns="http://www.w3.org/2000/svg" post-id="@post.Id" class="edit-icon" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                            </svg>

                            <svg xmlns="http://www.w3.org/2000/svg" post-id="@post.Id" class="delete-icon" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                            </svg>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="post-empty-box">
            <img src="/photos/empty-box.png"/>
            @if (ViewBag.isDraft == true)
            {
                <p>Your Draft is Empty</p>
            }
            else
            {
                <p>Your Post is Empty</p>
            }
            <button onclick="window.location.href='@Url.Action("UploadPost", "Post")'">Add Post</button>
        </div>
    }
</div>

<script>
    // delete functionality with confirmation popup
    let deletes = document.querySelectorAll(".delete-icon");

    deletes.forEach(icon => {
        icon.addEventListener("click", function (e) {
        e.stopPropagation();

        let postId = parseInt(this.getAttribute("post-id"));

        Swal.fire({
            title: 'Are you sure?',
            text: "Note: You won’t be able to undo this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Yes, delete it!'
            })
        .then((result) => {
            if (result.isConfirmed) {

            fetch("/post/delete", {
                method: "DELETE",
                headers: {
                "Content-Type": "application/json"
                },
                body: JSON.stringify({ PostId: postId })
                })
                .then(() => {
                Swal.fire('Deleted!', 'Your post has been deleted.', 'success')
                .then(() => location.reload());
                })
                .catch(err => console.log("error:", err));
                }
            });

        });
    });
    
    // this is for editing the post
    let edits = document.querySelectorAll(".edit-icon");

    edits.forEach(icon => {
        icon.addEventListener("click", function (e) {
            e.stopPropagation();

            let postId = this.getAttribute("post-id");

            window.location.href = `/post/edit/${postId}`;
        });
    });

</script>