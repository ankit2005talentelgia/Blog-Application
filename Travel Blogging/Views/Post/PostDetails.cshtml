@using Travel_Blogging.Models;
@model Travel_Blogging.DTOs.PostDto.CreateReviewDto;

@{
    var post = ViewBag.post as Travel_Blogging.Models.PostModel;

    // var reviews = ViewBag.review as List<ReviewModel>;
    int? userId=null;
    if (User.Identity.IsAuthenticated)
    {
        userId = Convert.ToInt32(ViewData["userId"]);
    }
}

<link rel="stylesheet" href="~/css/pages/PostDetails.css" />


<div class="container">

<!-- BLOG POST -->

    <div class="blog-card">

        <img class="blog-image" src=@post.ImageUrl>

        <div class="blog-content">

            @* <p class="title">Beautiful Beach in Goa</p> *@
            <p class="title">@post.Title</p>

            @* <p class="location">📍 Goa, India</p> *@
            <p class="location">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill" viewBox="0 0 16 16">
                    <path style="color: #de0d0d;" d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                </svg> @post.Location
            </p>

            <p class="date">Posted By: @post.Author.Name</p>

            <p class="description">
                @Html.Raw(post.Description)
            </p>

            <p class="date">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar" viewBox="0 0 16 16">
                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
                </svg>

                @post.CreatedAt.ToString("dd-MM-yyyy")</p>
        </div>
    </div>

<!-- REVIEW SECTION -->

    <div class="review-container">

        <p class="review-heading">User Reviews</p>

        @foreach (var review in post.Comments ?? new List<ReviewModel>())
        {
            <div class="review-card">
                <div class="review-card-content">
                    <p class="review-user">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                        </svg>

                        @review.User.Name
                    </p>
                    <p class="review-text">@review.Content</p>
                    <p class="date">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar" viewBox="0 0 16 16">
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
                        </svg>

                        @review.CreatedAt.ToString("dd-MM-yyyy")
                    </p>
                </div>

                @if (User.Identity.IsAuthenticated && review.UserId==userId)
                {
                    <div class="review-card-icons">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                        </svg>

                        <svg xmlns="http://www.w3.org/2000/svg" class="delete-icon" data-id="@review.Id" post-id="@post.Id" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                        </svg>
                    </div>
                }

            </div>
        } 

    <!-- ADD REVIEW -->

        <div class="add-review">

            <form asp-controller="Review" asp-action="CreateReview" method="post">

                <div class="form-input">
                    <textarea asp-for="Content" rows="3" placeholder="Write your review..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>

                    <input type="hidden" asp-for="PostId" value=@post.Id />
                </div>

                <button type="submit" class="add-review-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                        <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z" />
                    </svg>
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>

    let deletes = document.querySelectorAll(".delete-icon");
    deletes.forEach(icon => {
        icon.addEventListener("click", function () {
            let reviewId = this.getAttribute("data-id");
            let postId = this.getAttribute("post-id");
            
            fetch("/Review/DeleteReview", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ reviewId: reviewId, postId: postId })
            })
            .then(data => {
                location.reload();
            })
            .catch(error => console.log("Error:", error));
        });
    });
</script>