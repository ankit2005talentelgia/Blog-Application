@{
}

<link rel="stylesheet" href="~/css/pages/PostDetails.css" />


<div class="container">

<!-- BLOG POST -->

    <div class="blog-card">

        <img class="blog-image" src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e">

        <div class="blog-content">

            <div class="title">Beautiful Beach in Goa</div>

            <div class="location">📍 Goa, India</div>

            <div class="description">
                This place was absolutely amazing. The beach water was crystal clear and the sunset view was breathtaking.
                The environment was peaceful and perfect for relaxing with friends and family.
            </div>

            <div class="date">Posted on: 10 March 2026</div>

        </div>
    </div>

<!-- REVIEW SECTION -->

    <div class="review-container">

        <div class="review-heading">User Reviews</div>

        <div class="review-card">
            <div class="review-user">Rahul</div>
            <div class="review-text">Amazing place! The sunset view is unforgettable.</div>
        </div>

        <div class="review-card">
            <div class="review-user">Priya</div>
            <div class="review-text">Loved the beach vibes and peaceful environment.</div>
        </div>

        <div class="review-card">
            <div class="review-user">Amit</div>
            <div class="review-text">Perfect destination for vacation.</div>
        </div>

    <!-- ADD REVIEW -->

        <div class="add-review">
            <textarea rows="3" placeholder="Write your review..."></textarea>
            <button>Post Review</button>
        </div>

    </div>

</div>
