@using Travel_Blogging.Models;

@{
    var post = ViewBag.post as Travel_Blogging.Models.PostModel;
}

<link rel="stylesheet" href="~/css/pages/PostDetails.css" />


<div class="container">

<!-- BLOG POST -->

    <div class="blog-card">

        <img class="blog-image" src=@post.ImageUrl>

        <div class="blog-content">

            @* <p class="title">Beautiful Beach in Goa</p> *@
            <p class="title">@post.Title</p>

            @* <p class="location">📍 Goa, India</p> *@
            <p class="location">📍 @post.Location</p>

            <p class="description">
                @post.Description
            </p>

            <p class="date">Posted on: @post.CreatedAt.ToString("dd-MM-yyyy")</p>

        </div>
    </div>

<!-- REVIEW SECTION -->

    <div class="review-container">

        <p class="review-heading">User Reviews</p>

        <div class="review-card">
            <p class="review-user">Rahul Kumar</p>
            <p class="review-text">Amazing place! The sunset view is unforgettable.</p>
            <p class="date">Posted on: 10 March 2026</p>
        </div>

        <div class="review-card">
            <p class="review-user">Priya Singh Rajput</p>
            <p class="review-text">Loved the beach vibes and peaceful environment.</p>
            <p class="date">Posted on: 10 March 2026</p>
        </div>

    <!-- ADD REVIEW -->

        <div class="add-review">
            <textarea rows="3" placeholder="Write your review..."></textarea>
            <button class="add-review-btn">Post Review</button>
        </div>

    </div>

</div>
