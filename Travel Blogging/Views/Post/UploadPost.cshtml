@{ 
}
@model Travel_Blogging.DTOs.PostDto.CreatePostDto;


<link rel="stylesheet" href="~/css/pages/UploadPost.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jodit/build/jodit.min.css">

<div class="post-container">

    @* <h2 class="post-heading">Create Travel Post</h2> *@
    @* <form asp-action="CreatePost" method="post" enctype="multipart/form-data"> *@
    <form id="myForm" asp-action="@ViewBag.Action" asp-controller="Post" method="post" enctype="multipart/form-data">

        @* this is hidden field *@
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingImageUrl" />

        <!--  actionType hidden input for button -->
        <input type="hidden" name="actionType" id="actionType" />

        <div class="form-group">
            <label class="form-img-input">
                <img id="preview"
                     src="@(Model?.ExistingImageUrl ?? "")"
                     style="@(Model?.ExistingImageUrl != null ? "display:block" : "display:none")" />

                <span id="uploadText">
                    @(Model?.ExistingImageUrl != null ? "" : "Choose File")
                </span>

                <input asp-for="Image" type="file" accept="image/*" onchange="previewImage(event)">
            </label>
                <span asp-validation-for="Image" class="text-danger-image">@ViewBag.Error</span>
        </div>

        <div class="form-group">
            <label>Post Title</label>
            <input asp-for="Title" class="form-input" placeholder="Enter Post Title" />
             <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Location</label>
            <input asp-for="Location" class="form-input" placeholder="Enter Location"/>
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" id="editor"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

            <div class="button-group">
                <!-- Draft Button -->
                <button type="submit" class="draft-btn" onclick="setAction('draft')">
                    Save Draft
                </button>

                <!-- Publish Button -->
                <button type="submit" class="publish-btn" onclick="setAction('publish')">
                    @(Model==null || Model?.Id == 0 ? "Publish Post" : "Update & Publish")
                </button>
            </div>

    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/jodit/build/jodit.min.js"></script>

<script>
    // this is for showing the Image in Input field of image
    function previewImage(event){
        const file = event.target.files[0];
        if(file){
            const reader = new FileReader();
            reader.onload = function(){
                document.getElementById("preview").src = reader.result;
                document.getElementById("preview").style.display = "block";
                document.getElementById("uploadText").style.display = "none";
            }
            reader.readAsDataURL(file);
        }
    }

    // this is the Jodit library functionality which says which one is showing and which one is not showing
    document.addEventListener("DOMContentLoaded", function() {
        const editor = new Jodit('#editor', {
            height: 300,
            toolbarSticky: false,
            readonly: false,
            buttons: [
                'bold',
                'italic',
                'underline',
                '|',
                'ul',
                'ol',
                '|',
                'align'
            ],
            removeButtons: [
            'about','print','source','fullsize','table','link','video','file','image',
            ]
        });
    });


    // this is for when button is clicked
    function setAction(value) {
        document.getElementById("actionType").value = value;
    }

    // Prevents "Resubmit Form" warning on browser refresh or back navigation
    if (window.history.replaceState) {
        window.history.replaceState(null, null, window.location.href);
    }

</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
        $("#myForm input").blur(function () {
        $(this).valid();
        });
    });
    </script>
}