@{
}

<form id="profileForm"> 

    <img src="/photos/profile-icon.avif" />

    <div class="input-group">
        <label>Name</label>
        <input type="text" name="Name" value="@ViewData["name"]" disabled />
    </div>

    <div class="input-group">
        <label>Email</label>
        <input type="email" name="Email" value="@ViewBag.email" disabled />
    </div>

    <button type="button" id="editBtn">Update Profile</button>
    <button type="submit" id="saveBtn" style="display:none;">Save</button>
</form> 


