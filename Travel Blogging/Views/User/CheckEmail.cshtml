@{
    string email = ViewBag.Email as string;
    string maskedEmail = "";
    if (!string.IsNullOrEmpty(email))
    {
        var parts = email.Split('@');
        if (parts.Length == 2)
        {
            var userPart = parts[0];
            var domainPart = parts[1];
            if (userPart.Length > 2)
            {
                maskedEmail = userPart.Substring(0, 2) + new string('*', 5) + "@" + domainPart;
            }
            else
            {
                maskedEmail = userPart + new string('*', 5) + "@" + domainPart;
            }
        }
    }
}

<link rel="stylesheet" href="~/css/pages/EmailVerification.css" asp-append-version="true" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="email-verification">
    <div class="email-verification-body">
        <div class="email-icon">📩</div>
        <h1>Check your email</h1>
        <p>
            We’ve sent a verification link to <br />
            <span class="masked-email">@maskedEmail</span>
        </p>

        <button id="resend-btn" class="btn-primary" onclick="redirectToResend()">
            <span id="resend-text">Resend Email</span>
            <span id="resend-timer" style="display:none;">(30s)</span>
        </button>

        <p class="change-email-link">
            Wrong email? <a asp-controller="User" asp-action="UpdateEmail">Change it</a>
        </p>
    </div>
</div>

<script>
    function redirectToResend() {
        localStorage.setItem('email_resend_cooldown', Date.now() + 30000);
        window.location.href = '@Url.Action("ResendConfirmationEmail", "User")';
    }

    // Timer logic
    const resendBtn = document.getElementById('resend-btn');
    const resendText = document.getElementById('resend-text');
    const resendTimer = document.getElementById('resend-timer');

    let timeLeft = 30;
    const cooldownKey = 'email_resend_cooldown';

    function startTimer() {
        resendBtn.disabled = true;
        resendTimer.style.display = 'inline';
        
        const timer = setInterval(() => {
            timeLeft--;
            resendTimer.innerText = `(${timeLeft}s)`;
            
            if (timeLeft <= 0) {
                clearInterval(timer);
                resendBtn.disabled = false;
                resendTimer.style.display = 'none';
                resendText.innerText = 'Resend Email';
                localStorage.removeItem(cooldownKey);
            } else {
                localStorage.setItem(cooldownKey, Date.now() + (timeLeft * 1000));
            }
        }, 1000);
    }

    // Check if cooldown is active from previous attempt
    const activeCooldown = localStorage.getItem(cooldownKey);
    if (activeCooldown) {
        const remaining = Math.round((parseInt(activeCooldown) - Date.now()) / 1000);
        if (remaining > 0) {
            timeLeft = remaining;
            startTimer();
        }
    }

    // Start timer if coming from a resend action (optional, but good for UX)
    // For now, let's just make it possible to click once per 30s.
</script>