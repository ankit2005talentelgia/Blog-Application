@using Travel_Blogging.Models;

@{
    var datas = ViewData["posts"] as List<PostModel>;
}


<link rel="stylesheet" href="~/css/pages/HomePg.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="home-pg">
    <div class="home-pg-img">
        <p>Collect moments, not things.</p>
        <p class="home-pg-content">This websites is for helping the people to share the best moments in their life.</p>
        <div>
            <button onclick="window.location.href='@Url.Action("AllPost", "Post")'">Explore</button>
            <button onclick="window.location.href='@Url.Action("UploadPost", "Post")'">Create Blog</button>
        </div>
    </div>

    <p class="home-pg-heading">Latest Travels</p>

    @if (datas != null && datas.Count > 0)
    {
        <div class="home-content">
            @foreach (var post in datas)
            {
                <div class="home-content-box" onclick="window.location.href='@Url.Action("PostDetails", "Post", new { id = post.Id })'">
                    <div class="image-wrapper">
                        <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" />
                    </div>

                    <div class="post-info">
                        <p class="post-title">@post.Title</p>
                        <div class="post-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>@post.Location</span>
                        </div>
                        <div class="post-footer">
                            <span class="post-date">
                                <i class="fa-regular fa-calendar-days"></i>
                                @post.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="post-empty-box">
            <img src="/photos/empty-box.png" />
            <p>Post Is Empty</p>
            <button onclick="window.location.href='@Url.Action("UploadPost", "Post")'">Add Post</button>
        </div>
    }
</div>


